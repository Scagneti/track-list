<Window x:Class="WPF_TrackList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_TrackList"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="trackListOutputTextBox" TextWrapping="Wrap" TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="25"  Text="TrackList Output" Margin="28,10,524,21" IsReadOnly="True" BorderBrush="#FF7691E2" VerticalScrollBarVisibility="Auto">
            <TextBox.Background>
                <ImageBrush ImageSource="/line-pattern-background-minimal-style_53876-110613.jpg"/>
            </TextBox.Background>
        </TextBox>
        <Button x:Name="selectSongsButton" Content="Select Songs" Margin="281,372,425,21" Click="selectSongsButton_Click"/>

    </Grid>
</Window>
